@model IReadOnlyList<HomeNewsItem>
@using System.Globalization

<section class="section section--news" id="news" aria-labelledby="news-title">
    <div class="container-xl">
        <header class="section-header section-header--row reveal">
            <div>
                <h2 id="news-title" class="section-header__title">Новости</h2>
                <p class="section-header__lead">События фермы, виноградника и сыроварни IZOTOFF</p>
            </div>
            <a asp-controller="News" asp-action="Index" class="link-arrow">Все новости</a>
        </header>

        <div class="news-showcase reveal" id="home-news-showcase">
            <div class="news-showcase__articles">
                @for (var i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    var culture = new CultureInfo("ru-RU");

                    <article class="news-showcase__article@(i == 0 ? " is-active" : "")"
                             data-news-article
                             data-article-index="@i"
                             @(i > 0 ? Html.Raw("hidden") : null)>
                        <div class="news-showcase__content">
                            <time class="news-showcase__date" datetime="@item.PublishedAt.ToString("yyyy-MM-dd")">
                                @item.PublishedAt.ToString("d MMMM yyyy", culture)
                            </time>
                            <h3 class="news-showcase__heading">@item.Title</h3>
                            <p class="news-showcase__summary">@item.Summary</p>
                            <a asp-controller="News" asp-action="Index" class="btn btn-outline btn-sm news-showcase__more">
                                Читать далее
                            </a>
                        </div>

                        <div class="news-showcase__media">
                            <div class="news-gallery" data-news-gallery>
                                <div class="news-gallery__viewport">
                                    <div class="news-gallery__track" data-news-gallery-track>
                                        @for (var j = 0; j < item.ImageTones.Count; j++)
                                        {
                                            <div class="news-gallery__slide news-gallery__slide--@item.ImageTones[j]@(j == 0 ? " is-active" : "")"
                                                 data-news-gallery-slide
                                                 role="img"
                                                 aria-label="Иллюстрация @(j + 1) — @item.Title"></div>
                                        }
                                    </div>
                                </div>
                                @if (item.ImageTones.Count > 1)
                                {
                                    <div class="news-gallery__controls">
                                        <button type="button"
                                                class="news-gallery__btn news-gallery__btn--prev"
                                                data-news-gallery-prev
                                                aria-label="Предыдущее фото">
                                            ‹
                                        </button>
                                        <div class="news-gallery__dots" data-news-gallery-dots aria-hidden="true">
                                            @for (var j = 0; j < item.ImageTones.Count; j++)
                                            {
                                                <span class="news-gallery__dot@(j == 0 ? " is-active" : "")" data-news-gallery-dot></span>
                                            }
                                        </div>
                                        <button type="button"
                                                class="news-gallery__btn news-gallery__btn--next"
                                                data-news-gallery-next
                                                aria-label="Следующее фото">
                                            ›
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>

            @if (Model.Count > 1)
            {
                <div class="news-showcase__nav">
                    <button type="button" class="news-showcase__nav-btn" data-news-prev aria-label="Предыдущая новость">
                        ‹
                    </button>
                    <div class="news-showcase__dots" data-news-dots aria-hidden="true">
                        @for (var i = 0; i < Model.Count; i++)
                        {
                            <button type="button"
                                    class="news-showcase__dot@(i == 0 ? " is-active" : "")"
                                    data-news-dot="@i"
                                    aria-label="Новость @(i + 1)"></button>
                        }
                    </div>
                    <button type="button" class="news-showcase__nav-btn" data-news-next aria-label="Следующая новость">
                        ›
                    </button>
                </div>
            }
        </div>
    </div>
</section>
