@model Event

<article class="event-card reveal">
    <div class="event-card__image"
         style="@(string.IsNullOrWhiteSpace(Model.DisplayImagePath) ? null : $"--card-bg: url('{Model.DisplayImagePath}')")"
         aria-hidden="true"></div>
    <div class="event-card__body">
        <time class="event-card__date" datetime="@Model.EventDate.ToString("yyyy-MM-dd")">
            @Model.EventDate.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))
        </time>
        <h3 class="event-card__title">@Model.Title</h3>
        <div class="event-card__desc-wrap" data-event-desc>
            <p class="event-card__desc">@Model.Description</p>
        </div>
        <div class="event-card__actions">
            <button type="button"
                    class="btn btn-primary btn-sm"
                    data-booking-open
                    data-tour-kind="self"
                    data-event-title="@Model.Title"
                    data-event-date="@Model.EventDate.ToString("yyyy-MM-dd")">
                Записаться
            </button>
            <a class="btn btn-outline btn-sm event-card__details"
               asp-controller="Excursion"
               asp-action="Details"
               asp-route-id="@Model.Id"
               data-event-details
               hidden>Подробнее</a>
        </div>
    </div>
</article>
