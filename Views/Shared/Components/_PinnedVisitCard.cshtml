<article class="event-card event-card--pinned reveal">
    <div class="event-card__image event-card__image--pinned" aria-hidden="true"></div>
    <div class="event-card__body">
        <span class="event-card__date">@PinnedVisit.ScheduleLabel</span>
        <h3 class="event-card__title">@PinnedVisit.Title</h3>
        <div class="event-card__desc-wrap" data-event-desc>
            <p class="event-card__desc">@PinnedVisit.Description</p>
            <a class="event-card__details"
               asp-controller="Excursion"
               asp-action="Pinned"
               data-event-more
               hidden>Подробнее</a>
        </div>
        <button type="button"
                class="btn btn-primary btn-sm"
                data-booking-open
                data-tour-kind="guided"
                data-event-title="@PinnedVisit.Title">
            Записаться
        </button>
    </div>
</article>
