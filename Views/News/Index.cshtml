@model IReadOnlyList<HomeNewsItem>

@{
    ViewData["Title"] = "Новости";
}

<section class="page-hero page-hero--compact" aria-labelledby="page-title">
    <div class="page-hero__bg page-hero__bg--news" aria-hidden="true"></div>
    <div class="container-xl page-hero__content reveal">
        <h1 id="page-title" class="page-hero__title">Новости</h1>
        <p class="page-hero__lead">События фермы, виноградника и сыроварни IZOTOFF</p>
    </div>
</section>

<section class="section" aria-label="Лента новостей">
    <div class="container-xl">
        <div class="news-showcase reveal">
            @if (Model.Count == 0)
            {
                <p class="news-showcase__empty">Новостей пока нет.</p>
            }
            else
            {
                <partial name="Components/_NewsArticleList" model="Model" />
            }
        </div>
    </div>
</section>
