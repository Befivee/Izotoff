@model HomeIndexViewModel

<section class="hero" aria-label="IZOTOFF — официальный сайт">
    <div class="hero__bg" data-parallax></div>
    <div class="hero__overlay"></div>
    <div class="hero__content container-xl reveal">
        <p class="hero__eyebrow">@SiteInfo.Location</p>
        <h1 class="hero__title">@SiteInfo.CastleName<span class="visually-hidden"> — официальный сайт</span></h1>
        <p class="hero__subtitle">@SiteInfo.Tagline</p>
        <div class="hero__actions">
            <button type="button" class="btn btn-primary btn-lg" data-booking-open data-tour-kind="self">Записаться на экскурсию</button>
            <a asp-controller="Contacts" asp-action="Index" asp-fragment="kak-dobratsya" class="btn btn-outline btn-lg btn-outline--light">Как добраться</a>
        </div>
    </div>
    <a href="#quick-info" class="hero__scroll" aria-label="Прокрутить вниз">
        <span></span>
    </a>
</section>

<section class="quick-info" id="quick-info" aria-label="Быстрая информация">
    <div class="container-xl">
        <div class="quick-info__grid">
            <div class="info-card reveal">
                <span class="info-card__icon" aria-hidden="true">📍</span>
                <h3 class="info-card__title">Расположение</h3>
                <p class="info-card__text">@SiteInfo.DistanceFromKg</p>
            </div>
            <div class="info-card reveal">
                <span class="info-card__icon" aria-hidden="true">⏰</span>
                <h3 class="info-card__title">Время работы</h3>
                <p class="info-card__text">@SiteInfo.WorkingHours</p>
            </div>
            <div class="info-card reveal">
                <span class="info-card__icon" aria-hidden="true">💰</span>
                <h3 class="info-card__title">Стоимость</h3>
                <p class="info-card__text">@SiteInfo.TicketPrice</p>
            </div>
            <div class="info-card reveal">
                <span class="info-card__icon" aria-hidden="true">🚗</span>
                <h3 class="info-card__title">@SiteInfo.BusRoute</h3>
                <p class="info-card__text">@SiteInfo.TravelTime</p>
            </div>
        </div>
    </div>
</section>

<partial name="Components/_HomeNewsShowcase" model="Model.FeaturedNews" />

<section class="section section--why" aria-labelledby="why-title">
    <div class="container-xl">
        <header class="section-header reveal">
            <h2 id="why-title" class="section-header__title">Почему стоит посетить</h2>
        </header>
        <div class="why-grid">
            <article class="why-card reveal">
                <span class="why-card__num">01</span>
                <h3>Семейная ферма</h3>
                <p>С 2020 года мы создаём сыры из местного молока — сначала из регионального, затем из собственного стада коров симментальской породы.</p>
            </article>
            <article class="why-card reveal">
                <span class="why-card__num">02</span>
                <h3>Первый виноградник области</h3>
                <p>В 2025 году заложили 5 гектаров под лозы — сорта Пино нуар и Пино гри. На территории — дегустационный зал с видом на виноградник.</p>
            </article>
            <article class="why-card reveal">
                <span class="why-card__num">03</span>
                <h3>Дегустации и визиты</h3>
                <p>Посещение фермы, винные и гастрономические программы, пикники и тематические вечера — по записи.</p>
            </article>
            <article class="why-card reveal">
                <span class="why-card__num">04</span>
                <h3>Вкус региона</h3>
                <p>От нежного фермерского сыра до игристых напитков и будущих вин — всё создано на земле Калининградской области.</p>
            </article>
        </div>
    </div>
</section>

<section class="section section--events" aria-labelledby="visits-title">
    <div class="container-xl">
        <header class="section-header section-header--row reveal">
            <div>
                <h2 id="visits-title" class="section-header__title">Посещение</h2>
                <p class="section-header__lead">Основной визит на ферму и дополнительные программы</p>
            </div>
            <a asp-controller="Excursion" asp-action="Index" class="link-arrow">Все посещения</a>
        </header>
        <div class="cards-grid cards-grid--3">
            <partial name="Components/_PinnedVisitCard" />
            @foreach (var evt in Model.UpcomingEvents)
            {
                <partial name="Components/_EventCard" model="evt" />
            }
        </div>
    </div>
</section>

<section class="section section--directions-preview" aria-labelledby="directions-preview-title">
    <div class="container-xl">
        <div class="directions-preview reveal">
            <div class="directions-preview__content">
                <h2 id="directions-preview-title" class="section-header__title">Как добраться</h2>
                <ul class="directions-preview__list">
                    <li><strong>@SiteInfo.BusRoute</strong> — из Калининграда</li>
                    <li><strong>@SiteInfo.DistanceFromKg</strong></li>
                    <li><strong>@SiteInfo.TravelTime</strong></li>
                </ul>
                <div class="directions-preview__actions">
                    <a href="@SiteInfo.YandexMapsUrl" target="_blank" rel="noopener" class="btn btn-primary">Построить маршрут</a>
                    <a asp-controller="Contacts" asp-action="Index" asp-fragment="kak-dobratsya" class="btn btn-outline">Подробнее</a>
                </div>
            </div>
            <partial name="_YandexMap" model="@("lg")" />
        </div>
    </div>
</section>

<section class="section section--history" aria-labelledby="history-title">
    <div class="container-xl">
        <header class="section-header reveal">
            <h2 id="history-title" class="section-header__title">Наша история</h2>
        </header>
        <div class="history-timeline">
            <article class="history-step reveal">
                <span class="history-step__year">2020</span>
                <h3>Сыроварня</h3>
                <p>В разгар пандемии семья Изотовых начала создавать сыры из местного молока — так появилась мечта о собственной ферме.</p>
            </article>
            <article class="history-step reveal">
                <span class="history-step__year">2021–2024</span>
                <h3>Ферма растёт</h3>
                <p>Участок в Зеленоградском районе, стадо коров, сидр из местных яблок — сезон за сезоном хозяйство обретало новые грани.</p>
            </article>
            <article class="history-step reveal">
                <span class="history-step__year">2025</span>
                <h3>Виноградник</h3>
                <p>5 гектаров под Пино нуар и Пино гри, дегустационный зал с панорамным видом — первый виноградник Калининградской области.</p>
            </article>
        </div>
        <div class="section-cta reveal">
            <a asp-controller="About" asp-action="Index" class="link-arrow">Подробнее о нас</a>
        </div>
    </div>
</section>

<section class="section section--cta-banner" aria-label="Запись на экскурсию">
    <div class="container-xl">
        <div class="cta-banner reveal">
            <h2>Готовы к гастрономическому путешествию?</h2>
            <p>Запишитесь на экскурсию или мероприятие — места по записи</p>
            <button type="button" class="btn btn-primary btn-lg" data-booking-open data-tour-kind="self">Записаться</button>
        </div>
    </div>
</section>
