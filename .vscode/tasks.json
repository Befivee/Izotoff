{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch: site",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "watch",
        "run",
        "--launch-profile",
        "http",
        "--project",
        "${workspaceFolder}/Izotoff.csproj"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Now listening on:|Application started"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "watch: scss",
      "type": "shell",
      "command": "npm",
      "args": ["run", "scss:watch"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "sass",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Sass is watching",
          "endsPattern": "Compiled|Watching"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "dev: site + scss",
      "dependsOn": ["watch: site", "watch: scss"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
